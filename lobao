<!DOCTYPE html><html lang="pt-br"><head>    <meta charset="UTF-8">  <title>APTV Digital - Editor</title>    <style>        @font-face {            font-family: 'FreeMonoAPTV';            src: url('FreeMonoBold-full.ttf') format('truetype');            font-weight: 700;            font-style: normal;        }        body {            margin: 0;            padding: 0;            display: flex;            height: 100vh;            background: #eef2f7;            color: #0f172a;            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;            overflow: hidden;        }        .sidebar {            width: 460px;            background: #f8fafc;            box-shadow: 2px 0 18px rgba(15, 23, 42, 0.16);            padding: 18px 18px 34px;            overflow-y: auto;            z-index: 10;            box-sizing: border-box;        }        .sidebar-header {            background: #243b55;            color: #fff;            border-radius: 8px;            padding: 16px;            margin-bottom: 14px;        }        .sidebar-header h2 { margin: 0; font-size: 19px; }        .sidebar-header p { margin: 6px 0 0; color: #dbeafe; font-size: 12px; }        .dashboard-summary {            display: grid;            grid-template-columns: repeat(3, 1fr);            gap: 8px;            margin-bottom: 14px;        }        .summary-card {            background: #fff;            border: 1px solid #dbe3ee;            border-radius: 8px;            padding: 10px;        }        .summary-card span {            display: block;            color: #64748b;            font-size: 10px;            font-weight: 700;            text-transform: uppercase;        }        .summary-card strong {            display: block;            margin-top: 5px;            color: #0f172a;            font-size: 14px;            white-space: pre;            overflow: hidden;            text-overflow: ellipsis;        }        .section-tabs {            display: grid;            grid-template-columns: repeat(2, 1fr);            gap: 8px;            margin-bottom: 14px;        }        .section-tab {            border: 1px solid #cbd5e1;            border-radius: 8px;            background: #fff;            color: #334155;            cursor: pointer;            font-size: 12px;            font-weight: 800;            padding: 10px 8px;            text-align: left;        }        .section-tab.active {            background: #243b55;            border-color: #243b55;            color: #fff;        }        .field-panel {            display: none;            background: #fff;            border: 1px solid #dbe3ee;            border-radius: 8px;            padding: 14px;            margin-bottom: 14px;        }        .field-panel.active { display: block; }        .field-panel h3 {            margin: 0 0 12px;            font-size: 14px;        }        .field-grid {            display: grid;            grid-template-columns: repeat(2, minmax(0, 1fr));            gap: 10px;        }        .form-group.full { grid-column: 1 / -1; }        .field-subtitle {            grid-column: 1 / -1;            margin: 4px 0 0;            padding-top: 8px;            border-top: 1px solid #e2e8f0;            color: #334155;            font-size: 11px;            font-weight: 800;            text-transform: uppercase;        }        .form-group label {            display: block;            font-size: 10px;            font-weight: 700;            color: #64748b;            text-transform: uppercase;            margin-bottom: 4px;        }        .form-group input, .form-group textarea {            width: 100%;            padding: 8px;            border: 1px solid #cbd5e1;            border-radius: 4px;            font-family: 'FreeMonoAPTV', 'FreeMono', 'Liberation Mono', 'Courier New', monospace;            font-size: 13px;            font-weight: 700;            box-sizing: border-box;        }        .btn-save {            display: block;            width: 100%;            background: #0f766e;            color: white;            padding: 15px;            text-align: center;            border: none;            border-radius: 6px;            font-weight: 800;            font-size: 16px;            cursor: pointer;            margin-top: 8px;            margin-bottom: 12px;        }        .version-note { font-size: 10px; color: #64748b; text-align: center; margin-top: 10px; }        .preview-area {            flex: 1;            padding: 40px;            display: flex;            justify-content: center;            align-items: flex-start;            overflow-y: auto;            background: #3f3f46;            box-sizing: border-box;            padding-bottom: 80px;        }        .document-container {            position: relative;            width: 794px;            height: 1123px;            background: #fff;            box-shadow: 0 0 50px rgba(0,0,0,0.45);        }        .pdf-bg {            width: 100%;            height: 100%;            display: block;            user-select: none;        }        .overlay-text {            position: absolute;            background: transparent;            color: #000;            font-family: 'FreeMonoAPTV', 'FreeMono', 'Liberation Mono', 'Courier New', monospace;            font-weight: 700;            font-size: 13.333px;            line-height: 1;            display: block;            padding: 0;            pointer-events: none;            letter-spacing: 0;            white-space: pre;            overflow: visible;            transform: none;        }        @media print {            @page { size: 794px 1123px; margin: 0; }            html, body {                width: 794px;                height: 1123px;                background: #fff;                overflow: hidden;            }            body { display: block; }            .sidebar { display: none; }            .preview-area {                display: block;                width: 794px;                height: 1123px;                padding: 0;                margin: 0;                background: none;                overflow: hidden;            }            .document-container {                position: absolute;                left: 0;                top: 0;                width: 794px;                height: 1123px;                box-shadow: none;                margin: 0;                overflow: hidden;            }            .pdf-bg {                width: 794px;                height: 1123px;            }        }    </style></head><body>    <div class="sidebar">        <div class="sidebar-header">            <h2>Dashboard APTV</h2>            <p>Edite os campos de preenchimento e acompanhe o documento ao lado.</p>        </div>        <div class="dashboard-summary">            <div class="summary-card"><span>Placa</span><strong id="sum-placa">QEL7630</strong></div>            <div class="summary-card"><span>ATPV-e</span><strong id="sum-atpve">222980824001542</strong></div>            <div class="summary-card"><span>Vendedor</span><strong id="sum-vendedor_nome">MARCIO FERREIRA BARROS</strong></div>        </div>        <div class="section-tabs">            <button type="button" class="section-tab active" data-panel="veiculo" onclick="showPanel('veiculo')">Veículo</button>            <button type="button" class="section-tab" data-panel="documento" onclick="showPanel('documento')">Documento</button>            <button type="button" class="section-tab" data-panel="vendedor" onclick="showPanel('vendedor')">Vendedor</button>            <button type="button" class="section-tab" data-panel="comprador" onclick="showPanel('comprador')">Comprador</button>            <button type="button" class="section-tab" data-panel="auto" onclick="showPanel('auto')">Auto preencher</button>        </div>        <section class="field-panel" data-panel-content="auto">            <h3>Preenchimento automático</h3>            <div class="field-grid">                <div class="form-group full">                    <label>Cole os dados do veículo e proprietário</label>                    <textarea id="autofill-text" rows="12" placeholder="RENAVAM: 00000000&#10;PLACA: MXV7632..."></textarea>                </div>                <div class="form-group full">                    <button type="button" class="btn-save" onclick="applyAutoFill()">PREENCHER AUTOMÁTICO</button>                </div>            </div>        </section>        <section class="field-panel active" data-panel-content="veiculo">            <h3>Dados do veículo</h3>            <div class="field-grid">                <div class="field-subtitle">Identificação</div>                <div class="form-group"><label>Código Renavam</label><input id="field-renavam" value="01074086071" oninput="updatePreview('renavam', this.value)"></div>                <div class="form-group"><label>Placa</label><input id="field-placa" value="QEL7630" oninput="updatePreview('placa', this.value)"></div>                <div class="form-group"><label>Ano Fabricação</label><input id="field-ano_fab" value="2013" oninput="updatePreview('ano_fab', this.value)"></div>                <div class="form-group"><label>Ano Modelo</label><input id="field-ano_mod" value="2014" oninput="updatePreview('ano_mod', this.value)"></div>                <div class="field-subtitle">Características</div>                <div class="form-group full"><label>Marca / Modelo / Versão</label><input id="field-marca" value="HONDA/CG 150 TITAN EX" oninput="updatePreview('marca', this.value)"></div>                <div class="form-group"><label>CAT</label><input id="field-cat" value="***" oninput="updatePreview('cat', this.value)"></div>                <div class="form-group"><label>Cor Predominante</label><input id="field-cor" value="BRANCA" oninput="updatePreview('cor', this.value)"></div>                <div class="form-group full"><label>Chassi</label><input id="field-chassi" value="9C2KC1660ER009751" oninput="updatePreview('chassi', this.value)"></div>            </div>        </section>        <section class="field-panel" data-panel-content="documento">            <h3>Dados do documento</h3>            <div class="field-grid">                <div class="field-subtitle">CRV</div>                <div class="form-group"><label>Número CRV</label><input id="field-crv" value="223497164925" oninput="updatePreview('crv', this.value)"></div>                <div class="form-group"><label>Código Segurança CRV</label><input id="field-seguranca" value="13886153015" oninput="updatePreview('seguranca', this.value)"></div>                <div class="field-subtitle">ATPV-e</div>                <div class="form-group"><label>Número ATPV-e</label><input id="field-atpve" value="222980824001542" oninput="updatePreview('atpve', this.value)"></div>                <div class="form-group"><label>Data Emissão CRV</label><input id="field-data_emissao" value="30/04/2026" oninput="updatePreview('data_emissao', this.value)"></div>                <div class="form-group"><label>Hodômetro</label><input id="field-hodometro" value="*" oninput="updatePreview('hodometro', this.value)"></div>            </div>        </section>        <section class="field-panel" data-panel-content="vendedor">            <h3>Identificação do vendedor</h3>            <div class="field-grid">                <div class="field-subtitle">Dados pessoais</div>                <div class="form-group full"><label>Nome</label><input id="field-vendedor_nome" value="MARCIO FERREIRA BARROS" oninput="updatePreview('vendedor_nome', this.value)"></div>                <div class="form-group"><label>CPF/CNPJ</label><input id="field-vendedor_cpf" value="891.094.572-91" oninput="updatePreview('vendedor_cpf', this.value)"></div>                <div class="form-group"><label>E-mail</label><input id="field-vendedor_email" value="***" oninput="updatePreview('vendedor_email', this.value)"></div>                <div class="field-subtitle">Domicílio</div>                <div class="form-group"><label>Município</label><input id="field-vendedor_municipio" value="CONCORDIA DO PARA" oninput="updatePreview('vendedor_municipio', this.value)"></div>                <div class="form-group"><label>UF</label><input id="field-vendedor_uf" value="PA" oninput="updatePreview('vendedor_uf', this.value)"></div>            </div>        </section>        <section class="field-panel" data-panel-content="comprador">            <h3>Campos do comprador</h3>            <div class="field-grid">                <div class="field-subtitle">Dados pessoais</div>                <div class="form-group full"><label>Nome</label><input id="field-comprador_nome" value="" oninput="updatePreview('comprador_nome', this.value)"></div>                <div class="form-group"><label>CPF/CNPJ</label><input id="field-comprador_cpf" value="" oninput="updatePreview('comprador_cpf', this.value)"></div>                <div class="form-group"><label>E-mail</label><input id="field-comprador_email" value="" oninput="updatePreview('comprador_email', this.value)"></div>                <div class="field-subtitle">Domicílio</div>                <div class="form-group"><label>Município</label><input id="field-comprador_municipio" value="" oninput="updatePreview('comprador_municipio', this.value)"></div>                <div class="form-group"><label>UF</label><input id="field-comprador_uf" value="" oninput="updatePreview('comprador_uf', this.value)"></div>                <div class="form-group full"><label>Endereço</label><input id="field-comprador_endereco" value="" oninput="updatePreview('comprador_endereco', this.value)"></div>            </div>        </section>        <button class="btn-save" onclick="window.print()">GERAR PDF / IMPRIMIR</button>        <p class="version-note">APTV-e - HTML Atualizado</p>    </div>    <div class="preview-area">        <div class="document-container">            <img src="sua-nova-imagem.png" class="pdf-bg">            <div id="pv-detran_topo" class="overlay-text" style="top: 67.80px; left: 18.00px; width: 145px; height: 11px; background:#fff !important; color:#000; font-family: Arial, sans-serif; font-size: 7px;">DETRAN</div>            <div id="pv-renavam" class="overlay-text" style="top: 138.52px; left: 19.33px; width: 96px;">01074086071</div>            <div id="pv-placa" class="overlay-text" style="top: 185.19px; left: 19.33px; width: 66px;">QEL7630</div>            <div id="pv-ano_fab" class="overlay-text" style="top: 233.24px; left: 20.68px; width: 42px;">2013</div>            <div id="pv-ano_mod" class="overlay-text" style="top: 233.24px; left: 122.66px; width: 42px;">2014</div>            <div id="pv-marca" class="overlay-text" style="top: 289.20px; left: 19.33px; width: 176px;">HONDA/CG 150 TITAN EX</div>            <div id="pv-cat" class="overlay-text" style="top: 334.53px; left: 19.33px; width: 32px;">***</div>            <div id="pv-cor" class="overlay-text" style="top: 384.82px; left: 19.33px; width: 70px;">BRANCA</div>            <div id="pv-chassi" class="overlay-text" style="top: 385.53px; left: 183.40px; width: 150px;">9C2KC1660ER009751</div>            <div id="pv-crv" class="overlay-text" style="top: 434.86px; left: 19.33px; width: 112px;">223497164925</div>            <div id="pv-seguranca" class="overlay-text" style="top: 434.86px; left: 187.26px; width: 96px;">13886153015</div>            <div id="pv-atpve" class="overlay-text" style="top: 488.19px; left: 19.33px; width: 136px;">222980824001542</div>            <div id="pv-data_emissao" class="overlay-text" style="top: 488.19px; left: 184.39px; width: 92px;">30/04/2026</div>            <div id="pv-hodometro" class="overlay-text" style="top: 532.19px; left: 19.33px; width: 24px;">*</div>            <div id="pv-vendedor_nome" class="overlay-text" style="top: 111.85px; left: 426.66px; width: 190px;">MARCIO FERREIRA BARROS</div>            <div id="pv-vendedor_cpf" class="overlay-text" style="top: 163.85px; left: 426.66px; width: 112px;">891.094.572-91</div>            <div id="pv-vendedor_email" class="overlay-text" style="top: 163.85px; left: 580.00px; width: 60px;">***</div>            <div id="pv-vendedor_municipio" class="overlay-text" style="top: 207.85px; left: 426.66px; width: 166px;">CONCORDIA DO PARA</div>            <div id="pv-vendedor_uf" class="overlay-text" style="top: 212.57px; left: 719.74px; width: 34px;">PA</div>        </div>    </div>    <script>        function showPanel(panel) {            document.querySelectorAll('.section-tab').forEach((tab) => {                tab.classList.toggle('active', tab.dataset.panel === panel);            });            document.querySelectorAll('.field-panel').forEach((section) => {                section.classList.toggle('active', section.dataset.panelContent === panel);            });        }        function updatePreview(id, val) {            const previewEl = document.getElementById('pv-' + id);            if (previewEl) previewEl.innerText = val;            const summaryEl = document.getElementById('sum-' + id);            if (summaryEl) summaryEl.innerText = val || '-';            if (id === 'vendedor_uf') {                const topo = document.getElementById('pv-detran_topo');                if (topo) topo.innerText = `DETRAN`;            }        }        function applyAutoFill() {            const text = document.getElementById('autofill-text').value;            const lines = text.split('\n');            lines.forEach(line => {                const parts = line.split(':');                if (parts.length >= 2) {                    const key = parts[0].trim().toUpperCase();                    const value = parts.slice(1).join(':').trim();                    if (!value) return;                    if (key === 'RENAVAM') setField('renavam', value);                    else if (key === 'PLACA') setField('placa', value);                    else if (key === 'ANO FABRICACAO') setField('ano_fab', value);                    else if (key === 'ANO MODELO') setField('ano_mod', value);                    else if (key === 'MARCA / MODELO / VERSAO' || key === 'MARCA MODELO') setField('marca', value);                    else if (key === 'CAT') setField('cat', value);                    else if (key === 'COR') setField('cor', value);                    else if (key === 'CHASSI') setField('chassi', value);                    else if (key === 'NOME') setField('vendedor_nome', value);                    else if (key === 'CPF/CNPJ' || key === 'CPF') setField('vendedor_cpf', value);                    else if (key === 'MUNICIPIO' || key === 'CIDADE') setField('vendedor_municipio', value);                    else if (key === 'UF' || key === 'ESTADO') setField('vendedor_uf', value);                }            });        }        function setField(id, val) {            const input = document.getElementById('field-' + id);            if (input) {                input.value = val;                updatePreview(id, val);            }        }    </script></body></html>
